# Exemplo de .env - o arquivo real é GERADO por "make setup" com valores aleatórios.
# Nunca coloque segredos reais no Git.
HOST_UID=1000
HOST_GID=1000
POSTGRES_PASSWORD=gerado-no-setup
PAINEL_APP_PASSWORD=gerado-no-setup
INGEST_APP_PASSWORD=gerado-no-setup
SIEM_APP_PASSWORD=gerado-no-setup
FLASK_SECRET=gerado-no-setup
PSEUDO_KEY=gerado-no-setup
TZ=America/Sao_Paulo
# Opcionais:
# WAF_ATIVO=1                      # 0 desliga o mini-WAF do painel (só para provar a correção na causa raiz)
# WG_BIND=127.0.0.1                # interface onde a porta UDP 51820 do WireGuard é publicada
# VPN_IPS_CONHECIDOS=172.31.0.20,172.31.0.2,172.31.0.1
